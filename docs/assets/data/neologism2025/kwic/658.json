[[20240812,1,0,3,1,"","지리국공연산","(국립공원 연계 산행)의 연습산행이라는 것이었다.",119,"","https://n.news.naver.com/article/094/0000011989"],[20240812,1,0,3,1,"그래서 사람들은 ","지리국공연산","을 처절하게 그리는데, 저는 소풍 같았어요.\"",119,"","https://n.news.naver.com/article/094/0000011989"],[20240812,1,0,3,1,"그는 ","지리국공연산"," 이후 설악태극, 지리태극 등 이름값 높은 장거리길을 순식간에 섭렵해 갔다.",119,"","https://n.news.naver.com/article/094/0000011989"],[20241030,3,1,3,1,"가장 잘 알려진 것은 지리산, 덕유산, 가야산을 한 번에 걷는 ","지리국공연산","이다.",119,"","https://n.news.naver.com/article/094/0000012166"],[20241030,3,1,3,1,"","지리국공연산"," 종주.",119,"","https://n.news.naver.com/article/094/0000012166"],[20250416,9,1,3,1,"이번에는 ","지리국공연산","이다.",119,"","https://n.news.naver.com/article/094/0000012576"],[20250416,9,1,3,1,"","지리국공연산","에 비하면 길이도 더 긴데, 코스가 더 험하고 보급도 여의치 않아 훨씬 어렵다고 여겨진다.",119,"","https://n.news.naver.com/article/094/0000012576"],[20250723,12,1,3,1,"그 어렵다는 ","지리국공연산","(가야산~덕유산~지리산) 역행과 같은 특이한 장거리 코스도 다 걸었다.",119,"","https://n.news.naver.com/article/094/0000012809"]]